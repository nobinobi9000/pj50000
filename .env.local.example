# ================================================================
# Supabase 設定
# Supabase ダッシュボード > Settings > API から取得
# ================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ================================================================
# Anthropic API
# https://console.anthropic.com でAPIキーを発行
# ================================================================
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# ================================================================
# Stripe 設定
# https://dashboard.stripe.com/apikeys
# ================================================================
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
# Stripe ダッシュボード > Products でプレミアムプランの Price ID を取得
STRIPE_PREMIUM_PRICE_ID=price_your-premium-price-id

# ================================================================
# Upstash Redis（Rate Limiting）
# https://console.upstash.com でデータベースを作成
# 未設定の場合はレート制限をスキップ（開発環境向け）
# ================================================================
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ================================================================
# GitHub 設定（Self-healing PR 自動作成）
# PAT に repo スコープが必要
# ================================================================
GITHUB_TOKEN=ghp_your-personal-access-token
GITHUB_REPO_OWNER=your-github-username
GITHUB_REPO_NAME=pj5000

# ================================================================
# 通知設定（どちらか一方でも両方でも可）
# critical エラー時のみ通知（ノイズ削減）
# ================================================================
# LINE Notify: https://notify-bot.line.me/my/ でトークン発行
LINE_NOTIFY_TOKEN=your-line-notify-token
# Slack: Incoming Webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ================================================================
# Vercel Cron 認証シークレット
# openssl rand -hex 32 で生成し、Vercel の環境変数にも同じ値を設定
# ================================================================
CRON_SECRET=your-cron-secret-here

# ================================================================
# アプリケーション設定
# ================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
